<?xml version="1.0" encoding="utf-8" ?>
<!-- autoReload=true：改了本配置文件不用重启程序自动生效 -->
<!-- throwExceptions=false：日志本身出错不要拖垮主程序（静默失败） -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false">

  <!-- 输出目标：可以多个 -->
  <targets>
    <!-- 文件目标：每天一个文件，放在程序运行目录的 logs\ 下 -->
    <target name="file" xsi:type="File"
            fileName="${basedir}/logs/app-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}" />
    <!-- 调试目标：同时输出到 VS 的"输出"窗口 -->
    <target name="debugger" xsi:type="Debugger"
            layout="${longdate}|${level:uppercase=true}|${message}" />
  </targets>

  <!-- 规则：name="*" 表示所有日志；minlevel 是最低级别 -->
  <rules>
    <!-- Debug 及以上都写文件（采集这种高频动作用 Debug，事后可查） -->
    <logger name="*" minlevel="Debug" writeTo="file" />
    <!-- Info 及以上进 VS 输出窗口（启动、导出这种重要低频事件用 Info） -->
    <logger name="*" minlevel="Info"  writeTo="debugger" />
  </rules>
</nlog>
